{
  "name": "@minimax-bot/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "build:android": "npm run build -w @minimax-bot/protocol && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@minimax-bot/protocol": "*",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~58.0.22",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "react-test-renderer": "19.3.1",
    "typescript": "^6.0.3"
  }
}
