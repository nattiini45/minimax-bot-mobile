    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "mint:token": "npm run build -w @minimax-bot/protocol && node scripts/mint-bridge-token.mjs"
  },
  "dependencies": {
    "@minimax-bot/protocol": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "~5.9.3",
    "wrangler": "^4.154.0"
  }
